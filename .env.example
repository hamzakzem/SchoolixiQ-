# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SENTRY_DSN: Required for Sentry Error Tracking.
VITE_SENTRY_DSN=""

# Web push (FCM): VAPID public key from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates.
# Use either variable name; VITE_FCM_VAPID_KEY is preferred. Required for background web/PWA push notifications.
VITE_FCM_VAPID_KEY=
VITE_FIREBASE_VAPID_KEY=

# TUITION_CRON_SECRET: Protects POST /api/internal/tuition-reminders/run (Cloud Scheduler automatic tuition reminders)
TUITION_CRON_SECRET=

# DEPLOY_ENV: WHICH deployment this is. REQUIRED for Firebase Admin and every background worker to run (fail closed otherwise).
#   production  -> the live site (schoolixiq.com / schoolixiq.iq) with the PRODUCTION Firebase project's credentials
#   preview     -> any preview/staging site; Admin is used ONLY if the credentials belong to a different Firebase project
# A preview must NEVER receive the production FIREBASE_PRIVATE_KEY / FIREBASE_CLIENT_EMAIL. See docs/hostinger-environments.md
DEPLOY_ENV=

# FIREBASE_SERVICE_ACCOUNT: Required for Admin Auth operations (create/delete users)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
FIREBASE_PROJECT_ID="yala-safari-iq"
FIREBASE_CLIENT_EMAIL="your-service-account@yala-safari-iq.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
BOOTSTRAP_ADMIN_EMAILS="hamzakazem1999@gmail.com"
GEMINI_API_KEY=""
