rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return userExists() ? get(userPath()).data : {};
    }

    function userRole() {
      return userExists() && userDoc().keys().hasAll(['role']) ? userDoc().role : '';
    }

    function userSchoolId() {
      return userExists() && userDoc().keys().hasAll(['schoolId']) ? userDoc().schoolId : '';
    }

    function userEmail() {
      return userExists() && userDoc().keys().hasAll(['email']) ? userDoc().email : '';
    }

    function isSuperAdmin() {
      return signedIn() && (
        userRole() in ['superadmin', 'super_admin']
        || (
          request.auth.token.keys().hasAll(['role'])
          && request.auth.token.role in ['superadmin', 'super_admin']
        )
      );
    }

    function isPlatformAssistant() {
      return signedIn() && (
        userRole() == 'platform_assistant'
        || (
          userRole() == 'assistant'
          && (!userDoc().keys().hasAll(['schoolId']) || userDoc().schoolId == '' || userDoc().schoolId == null)
        )
      );
    }

    function isSchoolAssistant() {
      return userRole() in ['school_assistant']
        || (
          userRole() == 'assistant'
          && userDoc().keys().hasAll(['schoolId'])
          && userDoc().schoolId is string
          && userDoc().schoolId.size() > 0
        );
    }

    function isAdmin() {
      return userRole() in ['admin', 'school_admin'];
    }

    function isAssistant() {
      return userRole() == 'assistant' || userRole() == 'school_assistant';
    }

    function isTeacher() {
      return userRole() == 'teacher';
    }

    function isStaff() {
      return userRole() == 'staff';
    }

    function isGuard() {
      return userRole() == 'guard';
    }

    function isDistributor() {
      return userRole() == 'distributor';
    }

    function userDistributorId() {
      return userExists()
        && userDoc().keys().hasAll(['distributorId'])
        && userDoc().distributorId is string
        && userDoc().distributorId.size() > 0
        ? userDoc().distributorId
        : '';
    }

    function isParent() {
      return userRole() == 'parent';
    }

    function preservesSchoolDistributorFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'distributorId',
        'distributorName',
        'distributorCouponCode',
        'discountPercent',
        'commissionPercent',
        'trackingSource',
        'distributorCommissionPercent',
        'distributorDiscountPercent',
        'distributorDiscountAmount',
        'distributorCommissionType',
        'distributorLinkedAt',
        'distributorLinkedBy',
        'distributorCommissionPaused',
        'distributorCommissionPausedAt',
        'distributorCommissionPausedBy',
      ]);
    }

    function schoolCreateWithoutDistributorFields() {
      return !request.resource.data.keys().hasAny([
        'distributorId',
        'distributorName',
        'distributorCouponCode',
        'discountPercent',
        'commissionPercent',
        'trackingSource',
        'distributorCommissionPercent',
        'distributorDiscountPercent',
        'distributorDiscountAmount',
        'distributorCommissionType',
      ]);
    }

    function teacherAssignedClassId() {
      let u = userDoc();
      return u.keys().hasAll(['assignedClassId']) && u.assignedClassId is string && u.assignedClassId.size() > 0
        ? u.assignedClassId
        : (
          u.keys().hasAll(['primaryClassId']) && u.primaryClassId is string && u.primaryClassId.size() > 0
            ? u.primaryClassId
            : (
              u.keys().hasAll(['classId']) && u.classId is string && u.classId.size() > 0
                ? u.classId
                : ''
            )
        );
    }

    function teacherCanAccessClass(classId) {
      let u = userDoc();
      return (
        u.keys().hasAll(['assignedClassIds'])
        && u.assignedClassIds is list
        && u.assignedClassIds.size() > 0
        && classId in u.assignedClassIds
      ) || (
        teacherAssignedClassId().size() > 0
        && classId == teacherAssignedClassId()
      );
    }

    function isDismissalSchoolStaff() {
      return userRole() in ['admin', 'school_admin', 'assistant', 'staff'];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSchoolStaffRole() {
      return userRole() in ['admin', 'school_admin', 'assistant', 'school_assistant', 'teacher', 'staff'];
    }

    function isSchoolManagementRole() {
      return userRole() in ['admin', 'school_admin', 'assistant', 'school_assistant'];
    }

    function isSchoolMember(schoolId) {
      return isSuperAdmin() || (signedIn() && userSchoolId() == schoolId);
    }

    function hasSchoolId(data) {
      return data.keys().hasAll(['schoolId'])
        && data.schoolId is string
        && data.schoolId.size() > 0;
    }

    function sameSchool(resource) {
      return signedIn() && hasSchoolId(resource.data) && resource.data.schoolId == userSchoolId();
    }

    function sameSchoolRequest() {
      return signedIn() && hasSchoolId(request.resource.data) && request.resource.data.schoolId == userSchoolId();
    }

    function canManageSchool(schoolId) {
      return isSuperAdmin()
        || (signedIn() && userSchoolId() == schoolId && isSchoolManagementRole());
    }

    function isActiveSchoolDoc(school) {
      return (
        !school.keys().hasAll(['status'])
        || !(school.status in ['suspended', 'archived', 'inactive', 'rejected'])
      ) && (
        !school.keys().hasAll(['subscriptionStatus'])
        || !(school.subscriptionStatus in ['expired', 'cancelled', 'suspended'])
      );
    }

    function isSchoolOperationallyActive(schoolId) {
      return schoolId == 'system'
        || !exists(/databases/$(database)/documents/schools/$(schoolId))
        || isActiveSchoolDoc(
          get(/databases/$(database)/documents/schools/$(schoolId)).data
        );
    }

    function canWriteSchoolData(schoolId) {
      return isSuperAdmin()
        || (
          signedIn()
          && userSchoolId() == schoolId
          && isSchoolStaffRole()
          && isSchoolOperationallyActive(schoolId)
        );
    }

    function isParentOfStudent(studentId) {
      let student = get(/databases/$(database)/documents/students/$(studentId));
      return signedIn()
        && student.data.keys().hasAll(['parentIds'])
        && request.auth.uid in student.data.parentIds;
    }

    function isLinkedParentData(data) {
      return signedIn()
        && data.keys().hasAll(['parentIds'])
        && request.auth.uid in data.parentIds;
    }

    function isSchoolManagementReadRole() {
      return userRole() in ['admin', 'school_admin', 'assistant', 'staff'];
    }

    // Admin / staff school operations — excludes teacher, parent, guard.
    function canReadSchoolManagement() {
      return isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && isSchoolManagementReadRole());
    }

    function canReadTeacherClassScopedData() {
      return isTeacher()
        && hasSchoolId(resource.data)
        && userSchoolId() == resource.data.schoolId
        && resource.data.keys().hasAll(['classId'])
        && teacherCanAccessClass(resource.data.classId);
    }

    // Academic reads for teachers/parents within their school (not finance/admin).
    function canReadSchoolAcademicWide() {
      return canReadSchoolManagement()
        || (signedIn() && isTeacher() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId)
        || (signedIn() && isParent() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId);
    }

    function canReadAcademicOrParentLink() {
      return canReadSchoolManagement()
        || canReadTeacherClassScopedData()
        || isLinkedParentData(resource.data)
        || (resource.data.keys().hasAll(['studentId']) && isParentOfStudent(resource.data.studentId));
    }

    function canReadClassDocument(targetClassId) {
      return canReadSchoolManagement()
        || (signedIn() && isTeacher() && teacherCanAccessClass(targetClassId))
        || (signedIn() && isParent() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId);
    }

    function canReadStudentManagement() {
      return signedIn()
        && hasSchoolId(resource.data)
        && userSchoolId() == resource.data.schoolId
        && isSchoolManagementReadRole();
    }

    function canReadStudentAsTeacher() {
      return signedIn()
        && isTeacher()
        && hasSchoolId(resource.data)
        && userSchoolId() == resource.data.schoolId
        && resource.data.keys().hasAll(['classId'])
        && teacherCanAccessClass(resource.data.classId);
    }

    function canReadStudentAsParent() {
      return signedIn()
        && resource.data.keys().hasAll(['parentIds'])
        && request.auth.uid in resource.data.parentIds;
    }

    function canReadStudentByParentEmail() {
      return signedIn()
        && resource.data.keys().hasAll(['parentEmail'])
        && request.auth.token.keys().hasAll(['email'])
        && request.auth.token.email == resource.data.parentEmail;
    }

    function canReadStudentDocument() {
      return isSuperAdmin()
        || canReadStudentManagement()
        || canReadStudentAsTeacher()
        || canReadStudentAsParent()
        || canReadStudentByParentEmail();
    }

    function canReadOwnRegistration(data) {
      return signedIn() && (
        (data.keys().hasAll(['uid']) && data.uid == request.auth.uid)
        || (
          data.keys().hasAll(['email'])
          && effectiveAuthEmail().size() > 0
          && data.email == effectiveAuthEmail()
        )
        || (
          data.keys().hasAll(['customerInfo'])
          && data.customerInfo.keys().hasAll(['email'])
          && effectiveAuthEmail().size() > 0
          && data.customerInfo.email == effectiveAuthEmail()
        )
      );
    }

    function authTokenEmail() {
      return signedIn() && request.auth.token.keys().hasAll(['email'])
        ? request.auth.token.email
        : '';
    }

    function effectiveAuthEmail() {
      return userExists() && userEmail().size() > 0 ? userEmail() : authTokenEmail();
    }

    function platformUninitialized() {
      return !exists(/databases/$(database)/documents/users/metadata);
    }

    function canReadPlatformSuperAdminUserDoc() {
      return resource.data.keys().hasAll(['role'])
        && resource.data.role in ['superadmin', 'super_admin'];
    }

    function canReadOtherUserDoc(targetUserId) {
      return signedIn()
        && resource != null
        && (
          isSuperAdmin()
          || (
            resource.data.keys().hasAll(['email'])
            && effectiveAuthEmail().size() > 0
            && resource.data.email == effectiveAuthEmail()
          )
          || (
            hasSchoolId(resource.data)
            && isSchoolMember(resource.data.schoolId)
            && isSchoolStaffRole()
          )
          || (
            isParent()
            && hasSchoolId(resource.data)
            && userSchoolId() == resource.data.schoolId
            && resource.data.role in ['admin', 'assistant', 'teacher', 'staff']
          )
          || (
            userRole() in ['admin', 'school_admin', 'assistant', 'teacher']
            && userSchoolId().size() > 0
            && canReadPlatformSuperAdminUserDoc()
          )
        );
    }

    function selfOwnedUserFields() {
      return [
        'fcmTokens',
        'fcmTokenUpdatedAt',
        'fcmDevices',
        'webPushTokens',
        'pushTokens',
        'notificationPreferences',
        'lastSeen',
        'lastActiveAt',
        'deviceInfo',
        'updatedAt',
        'emailVerified',
        'displayName',
        'photoURL',
        'phoneNumber',
        'phone',
        'whatsapp',
        'language',
        'name',
        'claimedAt',
        'uid',
        'autoProv',
        'studentIds',
      ];
    }

    function privilegedUserFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && (
          !resource.data.keys().hasAll(['schoolId'])
          || request.resource.data.schoolId == resource.data.schoolId
        )
        && (
          !resource.data.keys().hasAll(['permissions'])
          || request.resource.data.permissions == resource.data.permissions
        )
        && (
          !resource.data.keys().hasAll(['status'])
          || request.resource.data.status == resource.data.status
        )
        && (
          !resource.data.keys().hasAll(['subscriptionStatus'])
          || request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        )
        && (
          !resource.data.keys().hasAll(['plan'])
          || request.resource.data.plan == resource.data.plan
        )
        && (
          !resource.data.keys().hasAll(['package'])
          || request.resource.data.package == resource.data.package
        )
        && (
          !resource.data.keys().hasAll(['packageId'])
          || request.resource.data.packageId == resource.data.packageId
        )
        && (
          !resource.data.keys().hasAll(['isSuperAdmin'])
          || request.resource.data.isSuperAdmin == resource.data.isSuperAdmin
        )
        && (
          !resource.data.keys().hasAll(['distributorId'])
          || request.resource.data.distributorId == resource.data.distributorId
        );
    }

    function canSelfUpdateUser(targetUserId) {
      return signedIn()
        && request.auth.uid == targetUserId
        && resource != null
        && privilegedUserFieldsUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(selfOwnedUserFields());
    }

    function canParentSelfLinkSchool(targetUserId) {
      return signedIn()
        && request.auth.uid == targetUserId
        && resource != null
        && request.resource.data.role == 'parent'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'studentIds', 'schoolId', 'updatedAt'])
        && (
          !resource.data.keys().hasAll(['schoolId'])
          || resource.data.schoolId == ''
          || request.resource.data.schoolId == resource.data.schoolId
        );
    }

    function canAdminSelfAssignSchool(targetUserId) {
      return signedIn()
        && request.auth.uid == targetUserId
        && resource != null
        && resource.data.role in ['admin', 'school_admin']
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolId', 'updatedAt']);
    }

    function canAdminUpdateUserInSchool(targetUserId) {
      return isSuperAdmin()
        || (
          signedIn()
          && (isAdmin() || isAssistant())
          && resource != null
          && hasSchoolId(resource.data)
          && sameSchool(resource)
        );
    }

    function canSelfCreateUser(targetUserId) {
      return signedIn()
        && request.auth.uid == targetUserId
        && !('isSuperAdmin' in request.resource.data)
        && (
          request.resource.data.role in ['parent', 'teacher', 'admin', 'school_admin', 'assistant', 'staff', 'guard']
          || (
            platformUninitialized()
            && request.resource.data.role in ['superadmin', 'super_admin']
          )
        );
    }

    function canSelfUpdateAdminOnboarding(targetUserId) {
      return signedIn()
        && request.auth.uid == targetUserId
        && resource != null
        && resource.data.role in ['admin', 'school_admin']
        && request.resource.data.role in ['admin', 'school_admin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'status',
          'subscriptionStatus',
          'schoolId',
          'pendingRegistrationId',
          'phone',
          'photoURL',
          'createdAt',
          'updatedAt',
          'autoProv',
        ]);
    }

    function canClaimProvisionedUserDoc(targetUserId) {
      return signedIn()
        && request.auth.uid != targetUserId
        && resource != null
        && resource.data.keys().hasAll(['email'])
        && effectiveAuthEmail().size() > 0
        && resource.data.email == effectiveAuthEmail();
    }

    function canCreateUserInSchool(targetUserId) {
      return isSuperAdmin()
        || canSelfCreateUser(targetUserId)
        || (
          signedIn()
          && isSchoolManagementRole()
          && hasSchoolId(request.resource.data)
          && sameSchoolRequest()
        );
    }

    function isConversationParticipant(data) {
      return signedIn()
        && data.keys().hasAll(['participants'])
        && (
          request.auth.uid in data.participants
          || ('admin' in data.participants && isAdmin() && hasSchoolId(data) && userSchoolId() == data.schoolId)
          || ('super_admin' in data.participants && isSuperAdmin())
          || (
            'super_admin' in data.participants
            && isPlatformAssistant()
            && (
              !data.keys().hasAll(['visibilityScope'])
              || !(data.visibilityScope in ['superadmin_private', 'superadmin_only'])
            )
          )
        );
    }

    function isSuperAdminPrivateMessage() {
      return resource.data.keys().hasAll(['visibilityScope'])
        && resource.data.visibilityScope in ['superadmin_private', 'superadmin_only'];
    }

    function canReadSystemMessage() {
      return isSuperAdmin()
        || (
          isPlatformAssistant()
          && !isSuperAdminPrivateMessage()
          && (
            resource.data.receiverId == request.auth.uid
            || resource.data.senderId == request.auth.uid
            || resource.data.receiverId == 'super_admin'
            || resource.data.receiverId == 'admin'
            || resource.data.audience == 'school_admin'
          )
        )
        || (signedIn() && resource.data.receiverId == request.auth.uid)
        || (signedIn() && resource.data.senderId == request.auth.uid)
        || (signedIn() && isAdmin() && resource.data.receiverId == 'admin' && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId)
        || (
          signedIn()
          && hasSchoolId(resource.data)
          && userSchoolId() == resource.data.schoolId
          && isSchoolStaffRole()
          && !isPlatformAssistant()
        );
    }

    function canWriteSystemMessage() {
      return isSuperAdmin()
        || (
          isPlatformAssistant()
          && hasSchoolId(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && (
            !request.resource.data.keys().hasAll(['visibilityScope'])
            || !(request.resource.data.visibilityScope in ['superadmin_private', 'superadmin_only'])
          )
        )
        || (signedIn() && hasSchoolId(request.resource.data) && canWriteSchoolData(request.resource.data.schoolId))
        || (
          signedIn()
          && isParent()
          && hasSchoolId(request.resource.data)
          && sameSchoolRequest()
          && isSchoolOperationallyActive(request.resource.data.schoolId)
        );
    }

    function canSoftDeleteSystemMessage() {
      return signedIn()
        && resource.data.keys().hasAll(['senderId'])
        && (
          isSuperAdmin()
          || resource.data.senderId == request.auth.uid
          || (
            isSchoolManagementRole()
            && hasSchoolId(resource.data)
            && userSchoolId() == resource.data.schoolId
          )
        );
    }

    function canParentUpdateStudent() {
      return signedIn()
        && isParent()
        && request.auth.uid in request.resource.data.parentIds
        && resource.data.schoolId == request.resource.data.schoolId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['parentIds', 'updatedAt', 'parentPhone', 'parentEmail', 'address']);
    }

    // -------------------------------------------------------------------------
    // Global / public collections
    // -------------------------------------------------------------------------

    // Subscription plans — public catalog; only Super Admin may mutate.
    match /packages/{packageId} {
      allow read, get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Distributors & coupons — Super Admin manages status/canLogin; distributors read own record only.
    match /distributors/{distributorId} {
      allow read, get: if isSuperAdmin()
        || (isDistributor() && userDistributorId() == distributorId);
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /distributorCoupons/{couponId} {
      allow read, get, list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /distributorMonthlyCommissions/{commissionId} {
      allow read, get: if isSuperAdmin()
        || (isDistributor() && resource.data.distributorId == userDistributorId());
      allow list: if isSuperAdmin()
        || (isDistributor() && resource.data.distributorId == userDistributorId());
      allow create, update, delete: if false;
    }

    // Distributor ↔ platform support chat (isolated from school messaging).
    match /distributor_support_conversations/{conversationId} {
      allow read, get: if isSuperAdmin()
        || (isDistributor() && resource.data.distributorId == userDistributorId());
      allow list: if isSuperAdmin()
        || (isDistributor() && resource.data.distributorId == userDistributorId());
      allow create: if isSuperAdmin()
        || (
          isDistributor()
          && request.resource.data.conversationType == 'distributor_support'
          && request.resource.data.distributorId == userDistributorId()
          && request.auth.uid in request.resource.data.participants
        );
      allow update: if isSuperAdmin()
        || (
          isDistributor()
          && resource.data.distributorId == userDistributorId()
          && request.resource.data.distributorId == resource.data.distributorId
        );
      allow delete: if isSuperAdmin();
    }

    match /distributor_support_messages/{messageId} {
      allow read, get: if isSuperAdmin()
        || (isDistributor() && resource.data.distributorId == userDistributorId());
      allow list: if isSuperAdmin()
        || (isDistributor() && resource.data.distributorId == userDistributorId());
      allow create: if isSuperAdmin()
        || (
          isDistributor()
          && request.resource.data.conversationType == 'distributor_support'
          && request.resource.data.distributorId == userDistributorId()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == 'distributor'
        );
      allow update: if isSuperAdmin()
        || (
          isDistributor()
          && resource.data.distributorId == userDistributorId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy'])
        );
      allow delete: if isSuperAdmin();
    }

    // Platform branding & config — public read; only Super Admin may mutate.
    match /system/{document=**} {
      allow read, get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // Schools — public read for login/footer/onboarding; scoped writes.
    match /schools/{schoolId} {
      allow read, get, list: if true;
      allow create: if isSuperAdmin()
        || (
          signedIn()
          && isAdmin()
          && request.resource.data.ownerUid == request.auth.uid
          && schoolCreateWithoutDistributorFields()
        );
      allow update: if isSuperAdmin()
        || (
          signedIn()
          && isSchoolMember(schoolId)
          && userRole() in ['admin', 'school_admin', 'assistant', 'teacher']
          && preservesSchoolDistributorFields()
        );
      allow delete: if isSuperAdmin();

      match /settings/{settingId} {
        allow read, get, list: if true;
        allow create, update, delete: if isSuperAdmin() || canManageSchool(schoolId);
      }
    }

    // Students — no public get (use /api/public/verify-student); query-safe list per role.
    match /students/{studentId} {
      allow get: if canReadStudentDocument();
      allow list: if (
          signedIn()
          && request.auth.token.keys().hasAll(['role'])
          && request.auth.token.role in ['superadmin', 'super_admin']
        )
        || isSuperAdmin()
        || canReadStudentManagement()
        || canReadStudentAsTeacher()
        || canReadStudentAsParent()
        || canReadStudentByParentEmail()
        || (
          signedIn()
          && request.query.limit <= 1
          && resource.data.keys().hasAll(['registrationNumber'])
        );
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole())
        || canParentUpdateStudent();
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isAdmin());
    }

    // Registration / subscription requests — open create; scoped read/update.
    match /registrations/{registrationId} {
      allow create: if true;
      allow read, get, list: if isSuperAdmin() || canReadOwnRegistration(resource.data);
      allow update: if isSuperAdmin()
        || (signedIn() && canReadOwnRegistration(resource.data) && resource.data.status == 'pending');
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Users
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow get: if canReadOtherUserDoc(userId);
      allow list: if canReadOtherUserDoc(userId);
      allow create: if canCreateUserInSchool(userId);
      allow update: if canSelfUpdateUser(userId)
        || canParentSelfLinkSchool(userId)
        || canAdminSelfAssignSchool(userId)
        || canSelfUpdateAdminOnboarding(userId)
        || canAdminUpdateUserInSchool(userId);
      allow delete: if isSuperAdmin()
        || (signedIn() && isAdmin() && hasSchoolId(resource.data) && sameSchool(resource))
        || canClaimProvisionedUserDoc(userId);
    }

    match /users/metadata {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        || (signedIn() && !exists(/databases/$(database)/documents/users/metadata));
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // School-scoped academic & operations collections
    // -------------------------------------------------------------------------

    match /classes/{classId} {
      allow read, get, list: if canReadClassDocument(classId);
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /attendance/{attendanceId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create, update: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId))
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /homework/{homeworkId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId))
        || (
          signedIn() && isParent() && sameSchool(resource)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        );
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole())
        || (
          signedIn() && sameSchool(resource) && isTeacher()
          && resource.data.keys().hasAll(['teacherId'])
          && resource.data.teacherId == request.auth.uid
        );
    }

    match /grades/{gradeId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /subjects/{subjectId} {
      allow read, get, list: if canReadSchoolAcademicWide();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
    }

    match /teacher_reports/{reportId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
    }

    match /advanced_reports/{reportId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /behavior_reports/{reportId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /announcements/{announcementId} {
      allow read, get, list: if canReadSchoolAcademicWide();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
    }

    match /payments/{paymentId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /installments/{installmentId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /payroll/{payrollId} {
      allow read, get, list: if canReadSchoolManagement();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /inventory/{itemId} {
      allow read, get, list: if canReadSchoolManagement();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /market/{itemId} {
      allow read, get, list: if canReadSchoolAcademicWide();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /marketplace/{itemId} {
      allow read, get, list: if canReadSchoolAcademicWide();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /orders/{orderId} {
      allow read, get, list: if isSuperAdmin()
        || (signedIn() && resource.data.keys().hasAll(['parentId']) && resource.data.parentId == request.auth.uid)
        || (signedIn() && hasSchoolId(resource.data) && canManageSchool(resource.data.schoolId))
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && isSchoolStaffRole());
      allow create: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(request.resource.data)
          && request.resource.data.parentId == request.auth.uid
        )
        || (
          signedIn()
          && hasSchoolId(request.resource.data)
          && canManageSchool(request.resource.data.schoolId)
        );
      allow update, delete: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && canManageSchool(resource.data.schoolId));
    }

    match /subscriptionRequests/{requestId} {
      allow read, get, list: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && canManageSchool(resource.data.schoolId));
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /id_cards/{cardId} {
      allow read, get, list: if canReadSchoolManagement()
        || (signedIn() && isParentOfStudent(cardId));
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole())
        || (
          signedIn() && isParentOfStudent(cardId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['parentEmail', 'residenceAddress', 'updatedAt'])
        );
      allow delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /student_archives/{archiveId} {
      allow read, get, list: if canReadSchoolManagement();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    // -------------------------------------------------------------------------
    // Notifications & preferences
    // -------------------------------------------------------------------------

    match /notifications/{notificationId} {
      function isNotificationRecipient() {
        return signedIn() && (
          resource.data.userId == request.auth.uid
          || (resource.data.keys().hasAll(['recipientId']) && resource.data.recipientId == request.auth.uid)
          || (resource.data.keys().hasAll(['receiverId']) && resource.data.receiverId == request.auth.uid)
        );
      }

      function notificationSchoolMatchesViewer() {
        return !resource.data.keys().hasAll(['schoolId'])
          || resource.data.schoolId == 'system'
          || userSchoolId() == resource.data.schoolId
          || (
            request.auth.token.keys().hasAll(['schoolId'])
            && request.auth.token.schoolId == resource.data.schoolId
          );
      }

      function isSuperAdminInboxNotification() {
        return signedIn()
          && request.auth.token.keys().hasAll(['role'])
          && request.auth.token.role in ['superadmin', 'super_admin']
          && resource.data.userId == 'super_admin';
      }

      function isSchoolAdminAudienceNotification() {
        return signedIn()
          && request.auth.token.keys().hasAll(['role', 'schoolId'])
          && request.auth.token.role in ['admin', 'school_admin', 'assistant']
          && resource.data.keys().hasAll(['schoolId', 'audience'])
          && resource.data.schoolId == request.auth.token.schoolId
          && resource.data.audience in ['school_admin', 'all_school'];
      }

      function canReadNotification() {
        return isSuperAdmin()
          || isSuperAdminInboxNotification()
          || (isNotificationRecipient() && notificationSchoolMatchesViewer())
          || isSchoolAdminAudienceNotification();
      }

      function isSchoolNotificationAuthor(schoolId) {
        return signedIn()
          && userSchoolId() == schoolId
          && userRole() in ['admin', 'school_admin', 'assistant', 'teacher'];
      }

      function notificationRecipientUserId() {
        return request.resource.data.userId;
      }

      function recipientUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data;
      }

      function recipientUserExists(userId) {
        return exists(/databases/$(database)/documents/users/$(userId));
      }

      function isSameSchoolRecipient(userId, schoolId) {
        return recipientUserExists(userId)
          && recipientUserData(userId).keys().hasAll(['schoolId'])
          && recipientUserData(userId).schoolId == schoolId;
      }

      function isSameSchoolParentRecipient(userId, schoolId) {
        return isSameSchoolRecipient(userId, schoolId)
          && recipientUserData(userId).keys().hasAll(['role'])
          && recipientUserData(userId).role == 'parent';
      }

      function isSameSchoolStaffRecipient(userId, schoolId) {
        return isSameSchoolRecipient(userId, schoolId)
          && recipientUserData(userId).keys().hasAll(['role'])
          && recipientUserData(userId).role in ['admin', 'school_admin', 'assistant', 'teacher', 'staff'];
      }

      function notificationStudentId() {
        return request.resource.data.keys().hasAll(['metadata'])
          && request.resource.data.metadata is map
          && request.resource.data.metadata.keys().hasAll(['studentId'])
          && request.resource.data.metadata.studentId is string
          ? request.resource.data.metadata.studentId
          : '';
      }

      function studentInSameSchool(studentId, schoolId) {
        return exists(/databases/$(database)/documents/students/$(studentId))
          && hasSchoolId(get(/databases/$(database)/documents/students/$(studentId)).data)
          && get(/databases/$(database)/documents/students/$(studentId)).data.schoolId == schoolId;
      }

      function parentLinkedToStudent(studentId, parentUserId) {
        let student = get(/databases/$(database)/documents/students/$(studentId)).data;
        return student.keys().hasAll(['parentIds'])
          && student.parentIds is list
          && parentUserId in student.parentIds;
      }

      function canCreateParentSchoolNotification() {
        let data = request.resource.data;
        let recipientId = notificationRecipientUserId();
        let studentId = notificationStudentId();
        return hasSchoolId(data)
          && data.keys().hasAll(['userId'])
          && isSchoolNotificationAuthor(data.schoolId)
          && isSchoolOperationallyActive(data.schoolId)
          && recipientId == data.userId
          && isSameSchoolParentRecipient(recipientId, data.schoolId)
          && (
            studentId.size() == 0
            || (
              studentInSameSchool(studentId, data.schoolId)
              && parentLinkedToStudent(studentId, recipientId)
            )
          );
      }

      function canCreateStaffSchoolNotification() {
        let data = request.resource.data;
        let recipientId = notificationRecipientUserId();
        return hasSchoolId(data)
          && data.keys().hasAll(['userId'])
          && isSchoolNotificationAuthor(data.schoolId)
          && isSchoolOperationallyActive(data.schoolId)
          && recipientId == data.userId
          && isSameSchoolStaffRecipient(recipientId, data.schoolId);
      }

      function isSuperAdminRecipient(userId) {
        return recipientUserExists(userId)
          && recipientUserData(userId).keys().hasAll(['role'])
          && recipientUserData(userId).role in ['superadmin', 'super_admin'];
      }

      function notificationSourceSchoolId() {
        return request.resource.data.keys().hasAll(['metadata'])
          && request.resource.data.metadata is map
          && (
            (
              request.resource.data.metadata.keys().hasAll(['sourceSchoolId'])
              && request.resource.data.metadata.sourceSchoolId is string
              && request.resource.data.metadata.sourceSchoolId.size() > 0
            )
            || (
              request.resource.data.metadata.keys().hasAll(['schoolId'])
              && request.resource.data.metadata.schoolId is string
              && request.resource.data.metadata.schoolId.size() > 0
              && request.resource.data.metadata.schoolId != 'system'
            )
          )
          ? (
            request.resource.data.metadata.keys().hasAll(['sourceSchoolId'])
              && request.resource.data.metadata.sourceSchoolId is string
              && request.resource.data.metadata.sourceSchoolId.size() > 0
              ? request.resource.data.metadata.sourceSchoolId
              : request.resource.data.metadata.schoolId
          )
          : '';
      }

      function canCreateSuperAdminRecipientNotification() {
        let data = request.resource.data;
        let recipientId = notificationRecipientUserId();
        let sourceSchoolId = notificationSourceSchoolId();
        return signedIn()
          && data.keys().hasAll(['userId', 'schoolId'])
          && data.schoolId == 'system'
          && sourceSchoolId.size() > 0
          && isSchoolNotificationAuthor(sourceSchoolId)
          && userRole() in ['admin', 'school_admin', 'assistant', 'teacher']
          && recipientId == data.userId
          && isSuperAdminRecipient(recipientId);
      }

      function canCreateSchoolNotification() {
        return canCreateParentSchoolNotification()
          || canCreateStaffSchoolNotification()
          || canCreateSuperAdminRecipientNotification();
      }

      allow get: if canReadNotification();
      allow list: if canReadNotification();
      allow create: if isSuperAdmin()
        || (
          signedIn()
          && request.resource.data.userId == 'super_admin'
          && request.resource.data.schoolId == 'system'
        )
        || canCreateSchoolNotification();
      allow update, delete: if isSuperAdmin()
        || (isNotificationRecipient() && notificationSchoolMatchesViewer())
        || isSuperAdminInboxNotification();
    }

    match /notification_preferences/{prefId} {
      allow read, get, list: if isSuperAdmin()
        || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create: if isSuperAdmin()
        || (signedIn() && request.resource.data.parentId == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (signedIn() && resource.data.parentId == request.auth.uid);
    }

    match /tuition_reminder_tracking/{trackingId} {
      allow read, get, list: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(resource.data)
          && userSchoolId() == resource.data.schoolId
          && isSchoolManagementRole()
        );
      allow create, update: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(request.resource.data)
          && userSchoolId() == request.resource.data.schoolId
          && isSchoolManagementRole()
        );
      allow delete: if isSuperAdmin();
    }

    match /tuition_reminder_logs/{logId} {
      allow read, get, list: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(resource.data)
          && userSchoolId() == resource.data.schoolId
          && isSchoolManagementRole()
        );
      allow create: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(request.resource.data)
          && userSchoolId() == request.resource.data.schoolId
          && isSchoolManagementRole()
          && request.resource.data.sentBy == request.auth.uid
        );
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Messaging
    // -------------------------------------------------------------------------

    match /system_messages/{messageId} {
      allow read, get, list: if canReadSystemMessage();
      allow create: if canWriteSystemMessage();
      // Soft-delete / read receipts only — permanent delete MUST use Admin API (allow delete: false for clients except broken legacy; blocked below)
      allow update: if canSoftDeleteSystemMessage()
        || (
          canReadSystemMessage()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
        );
      // Client hard-delete disabled — Super Admin uses POST /api/admin/messages/permanent-delete
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, get, list: if isSuperAdmin()
        || isPlatformAssistant()
        || isConversationParticipant(resource.data);
      allow create, update: if isSuperAdmin()
        || isPlatformAssistant()
        || (
          signedIn()
          && hasSchoolId(request.resource.data)
          && isConversationParticipant(request.resource.data)
        );
      allow delete: if false;
    }
    
    // -------------------------------------------------------------------------
    // Audit / diagnostics / logs (conservative)
    // -------------------------------------------------------------------------

    match /audit_logs/{logId} {
      allow create: if signedIn()
        && (
          (hasSchoolId(request.resource.data) && request.resource.data.actorId == request.auth.uid)
          || request.resource.data.userId == request.auth.uid
        );
      allow read, get, list: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(resource.data)
          && userSchoolId() == resource.data.schoolId
          && isSchoolManagementRole()
        );
      allow update, delete: if isSuperAdmin();
    }

    match /login_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'event', 'createdAt']);
      allow read, get, list: if isSuperAdmin()
        || (
          signedIn()
          && hasSchoolId(resource.data)
          && userSchoolId() == resource.data.schoolId
          && isSchoolManagementRole()
        );
      allow update, delete: if isSuperAdmin();
    }

    match /system_diagnostics/{diagId} {
      allow create: if signedIn();
      allow read, get, list, update, delete: if isSuperAdmin();
    }

    match /print_logs/{logId} {
      allow create: if signedIn() && hasSchoolId(request.resource.data);
      allow read, get, list: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && isSchoolManagementReadRole());
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Legacy / server-cleanup collections (conservative school scoping)
    // -------------------------------------------------------------------------

    match /staff/{docId} {
      allow read, get, list: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && isSchoolManagementReadRole());
      allow create: if isSuperAdmin()
        || (signedIn() && hasSchoolId(request.resource.data) && canManageSchool(request.resource.data.schoolId));
      allow update, delete: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && canManageSchool(resource.data.schoolId));
    }

    match /behavior/{docId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
    }

    match /exams/{docId} {
      allow read, get, list: if canReadSchoolAcademicWide();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && canWriteSchoolData(request.resource.data.schoolId));
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && canWriteSchoolData(resource.data.schoolId));
    }

    match /fees/{docId} {
      allow read, get, list: if canReadAcademicOrParentLink();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /expenses/{docId} {
      allow read, get, list: if canReadSchoolManagement();
      allow create: if isSuperAdmin()
        || (signedIn() && sameSchoolRequest() && isSchoolManagementRole());
      allow update, delete: if isSuperAdmin()
        || (signedIn() && sameSchool(resource) && isSchoolManagementRole());
    }

    match /logs/{docId} {
      allow create: if signedIn();
      allow read, get, list, update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Smart Gate — dismissal_requests
    // -------------------------------------------------------------------------

    match /dismissal_requests/{requestId} {
      function dismissalData() {
        return resource.data;
      }

      function dismissalRequestData() {
        return request.resource.data;
      }

      function sameDismissalSchool() {
        return signedIn()
          && hasSchoolId(dismissalData())
          && userSchoolId() == dismissalData().schoolId;
      }

      function sameDismissalSchoolOnCreate() {
        return signedIn()
          && hasSchoolId(dismissalRequestData())
          && userSchoolId() == dismissalRequestData().schoolId;
      }

      function isDismissalParentOwner() {
        return signedIn()
          && dismissalData().keys().hasAll(['parentId'])
          && dismissalData().parentId == request.auth.uid;
      }

      // Transitions are enforced server-side only (Admin SDK via /api/dismissal/*).
      // Clients may read; direct writes are blocked except Super Admin maintenance.

      allow get: if isSuperAdmin()
        || (isDismissalSchoolStaff() && sameDismissalSchool())
        || (isGuard() && sameDismissalSchool())
        || isDismissalParentOwner();

      allow list: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && (
          isDismissalSchoolStaff()
          || isGuard()
          || (isParent() && resource.data.keys().hasAll(['parentId']) && resource.data.parentId == request.auth.uid)
        ));

      allow create: if isSuperAdmin();

      allow update: if isSuperAdmin();

      allow delete: if isSuperAdmin()
        || (isDismissalSchoolStaff() && sameDismissalSchool());
    }

    match /dismissal_logs/{logId} {
      allow read: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && isDismissalSchoolStaff());
      allow write: if false;
    }

    match /dismissal_snapshots/{requestId} {
      allow read: if isSuperAdmin()
        || (signedIn() && hasSchoolId(resource.data) && userSchoolId() == resource.data.schoolId && (
          isDismissalSchoolStaff()
          || isGuard()
          || (isParent() && exists(/databases/$(database)/documents/dismissal_requests/$(requestId))
            && get(/databases/$(database)/documents/dismissal_requests/$(requestId)).data.parentId == request.auth.uid)
        ));
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // School live presence (Super Admin read; school members write own school)
    // -------------------------------------------------------------------------

    match /school_presence/{schoolId} {
      allow read: if isSuperAdmin();

      allow create: if signedIn()
        && userSchoolId() == schoolId
        && userRole() != 'superadmin'
        && request.resource.data.schoolId == schoolId;

      allow update: if signedIn()
        && userSchoolId() == schoolId
        && userRole() != 'superadmin'
        && resource.data.schoolId == schoolId
        && request.resource.data.schoolId == schoolId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schoolId',
          'online',
          'activeUsers',
          'lastSeenAt',
          'lastHeartbeatAt',
          'lastActiveUserId',
          'lastActiveUserName',
          'lastActiveRole',
          'updatedAt'
        ]);

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Default deny — no broad authenticated fallback
    // -------------------------------------------------------------------------
  }
}
